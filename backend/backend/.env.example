# Copy to `.env` for local work. On the live server set these in the hosting dashboard instead;
# never commit the real file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"

# ---- Server -------------------------------------------------------------------------------
NODE_ENV=development            # "production" on the live server
PORT=5000
# Public address(es) of the website (https://... in production). Used for e-mail links, payment
# return pages and CORS. Extra allowed origins: CORS_ORIGINS=https://a.example,https://b.example
FRONTEND_URL=http://localhost:4000
# Public address of THIS API (https://... in production). Used in the confirm / unsubscribe links of the
# newsletter and reminder e-mails; without it they point at FRONTEND_URL, which must then forward /api.
BACKEND_URL=http://localhost:5000
# Reverse-proxy hops to trust for the visitor's address. Default: 1 in production (Render), 0 locally.
# TRUST_PROXY=1

# ---- Database: use a DEDICATED database name per environment ---------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database-name>?retryWrites=true&w=majority

# ---- Login tokens: a different long random value per environment ---------------------------
JWT_SECRET=
JWT_EXPIRE=30d

# ---- First super admin (created ONCE if missing; remove SUPERADMIN_PASSWORD afterwards) -----
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Images / video -------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- E-mail (Gmail app password or an SMTP provider) ----------------------------------------
EMAIL_USER=
EMAIL_PASS=

# ---- Payments: "test" for sandbox, "live" only with real credentials ---------------------------
ESEWA_MODE=test
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_SUCCESS_URL=http://localhost:4000/donate/success
ESEWA_FAILURE_URL=http://localhost:4000/donate/failure
KHALTI_MODE=test
KHALTI_SECRET_KEY=
KHALTI_RETURN_URL=http://localhost:4000/donate/success
KHALTI_WEBSITE_URL=http://localhost:4000
IPS_MODE=test
IPS_MERCHANT_ID=
IPS_APP_ID=
IPS_APP_NAME=
IPS_PASSWORD=
IPS_PRIVATE_KEY=

# ---- Google sign-in (the web app sends a Google token; only the client id is needed) ---------
GOOGLE_CLIENT_ID=

# ---- Facebook live status (optional) --------------------------------------------------------
FB_PAGE_URL=https://www.facebook.com/shreeramchandramandir
FB_PAGE_TOKEN=
