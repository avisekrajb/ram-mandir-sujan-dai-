# Website settings for cPanel hosting (Apache / LiteSpeed). This file is copied into the build folder by
# "npm run build": upload it together with the rest of the website files into the domain's public_html.
# (The file "_headers" next to it is for Netlify / Cloudflare Pages and is ignored by cPanel.)
#
# What it does
#   1. Sends every visitor to the https:// address.
#   2. Never serves private or development files (names starting with a dot, source maps, logs, backups, SQL, zips).
#      The ".well-known" folder stays reachable: the free SSL certificate (AutoSSL / Let's Encrypt) needs it.
#   3. Lets the single-page website answer every address (/events, /blogs/12 ...) by opening index.html.
#   4. Switches directory listings off.
#   5. Adds the browser protection headers. The Content-Security-Policy is REPORT-ONLY: the browser lists what it
#      would block in its console but blocks nothing, so it cannot break the live site. After a week without
#      reports, rename "Content-Security-Policy-Report-Only" to "Content-Security-Policy" to enforce it.
#
# BEFORE USING: replace https://YOUR-API-HOST in the policy below with the real address of the backend API
# (the value of REACT_APP_API_URL without /api, for example https://api.your-temple-domain.org).
# After uploading, open the website, and check that the pages and a deep link (for example /events) open.
# If the host does not allow the "Header" lines (a 500 error appears), remove the <IfModule mod_headers.c> block.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS only
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Private and development files are never served
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(map|env|log|bak|sql|zip|tar|gz|swp)$ - [F,L]

  # 3. Single-page website: anything that is not a real file or folder is answered by index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # 5. Browser protection headers (a browser ignores Strict-Transport-Security on plain http)
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://res.cloudinary.com; connect-src 'self' https://YOUR-API-HOST https://www.googleapis.com https://accounts.google.com/gsi/ https://api.open-meteo.com https://open.er-api.com https://www.usemiti.com https://res.cloudinary.com blob: data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://www.google.com https://www.openstreetmap.org https://accounts.google.com; form-action 'self' https://rc-epay.esewa.com.np https://epay.esewa.com.np https://uat.connectips.com https://connectipswebgw.connectips.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

  # The page shell must always be fetched fresh so a new release is picked up at once
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
